# Exemplo de configuração. Copie para ".env" e preencha com valores reais.
# O ".env" NAO e versionado (ver .gitignore). Este arquivo serve de referencia.

# PAT do Azure DevOps (backend). Nunca exponha ao frontend (nao use prefixo VITE_).
AZURE_DEVOPS_PAT=coloque-seu-pat-aqui

# Pasta sincronizada (OneDrive) onde ficam os PPTX do review quinzenal.
# O script extrair-pptx.mjs pega o .pptx mais recente desta pasta quando
# executado sem argumento.
# Ex. Windows: C:\Users\SEU_USUARIO\OneDrive - POLIEDRO\Shortcuts\Diretoria de Inovação e Aprendizagem - Atual
REVIEW_PPTX_DIR=
